#compdef cgc
#
# zsh completion for cgc. Install as:
#   $(PREFIX)/share/zsh/site-functions/_cgc

_cgc() {
    local -a subcommands
    subcommands=(fetch pull update)

    local -a clone_options update_options
    clone_options=(
        '--host[default host for owner/repo]:host:'
        '--token[bearer token for HTTPS auth]:token:'
        '--token-file[read the token from a file]:file:_files'
        '-b[branch to check out]:branch:'
        '--branch[branch to check out]:branch:'
        '--depth[shallow clone depth]:commits:'
        '--single-branch[clone only one branch]'
        '--no-single-branch[fetch all branches]'
        '--bare[create a bare repository]'
        '--mirror[mirror all refs]'
        '--no-checkout[skip the working-tree checkout]'
        '--no-tags[do not fetch tags]'
        '--origin[name of the remote]:name:'
        '-q[suppress progress messages]'
        '--quiet[suppress progress messages]'
        '-h[show help]'
        '--help[show help]'
        '-V[show version]'
        '--version[show version]'
    )
    update_options=(
        '--token[bearer token for HTTPS auth]:token:'
        '--token-file[read the token from a file]:file:_files'
        '-b[branch to fetch or update]:branch:'
        '--branch[branch to fetch or update]:branch:'
        '--tags[fetch and update tags]'
        '--no-tags[do not fetch tags]'
        '--force[overwrite conflicting local tags]'
        '--prune[delete stale refs]'
        '--remote[remote name]:name:'
        '-q[suppress status output]'
        '--quiet[suppress status output]'
        '-h[show help]'
        '--help[show help]'
        '-V[show version]'
        '--version[show version]'
    )

    _arguments -C \
        '1: :->command' \
        '*:: :->args'

    case $state in
        command)
            _describe 'command' subcommands
            _files -/
            ;;
        args)
            if [[ $words[1] == (fetch|pull|update) ]]; then
                _arguments $update_options '*:directory:_files -/'
            else
                _arguments $clone_options '*:directory:_files -/'
            fi
            ;;
    esac
}

_cgc "$@"
